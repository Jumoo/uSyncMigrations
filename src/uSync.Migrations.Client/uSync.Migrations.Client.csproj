<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <StaticWebAssetBasePath>/</StaticWebAssetBasePath>

    <!--
      Migrations-Client is the npm/vite source for the backoffice client - it is not
      code for this csproj to compile, and without this it gets swept up by the SDK's
      default item globs and shipped inside the package as content/contentFiles
      (package.json, tsconfig.json, package-lock.json). The built output it produces,
      wwwroot/App_Plugins/uSyncMigrationsClient, is unaffected and still packs normally
      as a static web asset.
    -->
    <DefaultItemExcludes>$(DefaultItemExcludes);Migrations-Client/**</DefaultItemExcludes>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>uSync.Migrations.Client</PackageId>
    <Product>uSync.Migrations.Client</Product>
    <Title>uSync.Migrations.Client</Title>
  </PropertyGroup>


  <ItemGroup>
    <PackageReference Include="Umbraco.Cms.Web.Website" />
    <PackageReference Include="Umbraco.Cms.Web.Common" />
    <PackageReference Include="Umbraco.Cms.Api.Common" />
    <PackageReference Include="Umbraco.Cms.Api.Management" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="wwwroot\" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\uSync.Migrations.Core\uSync.Migrations.Core.csproj" />
  </ItemGroup>

</Project>
